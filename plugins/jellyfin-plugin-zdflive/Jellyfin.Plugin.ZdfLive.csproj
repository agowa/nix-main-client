<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ZdfLive</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ZdfLive</AssemblyName>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the exact contract version of the server that runs on PC-001 (jellyfin 10.11.11).
         ExcludeAssets=runtime: MediaBrowser.* and Microsoft.Extensions.* are already loaded by the
         server, so copying them next to the plugin would shadow the server's own assemblies. -->
    <PackageReference Include="Jellyfin.Common" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
