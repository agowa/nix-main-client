<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ZdfLive</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ZdfLive</AssemblyName>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the exact contract version of the server that runs on PC-001 (jellyfin 10.11.11).
         ExcludeAssets=runtime: MediaBrowser.* and Microsoft.Extensions.* are already loaded by the
         server, so copying them next to the plugin would shadow the server's own assemblies. -->
    <PackageReference Include="Jellyfin.Common" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The configuration page, the ES module it names in data-controller, and the channel list that
         module renders. All three are served through /web/ConfigurationPage?name=&lt;page name&gt;, so all
         three have to be registered as pages in Plugin.GetPages() and embedded here. -->
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configController.js" />
    <EmbeddedResource Include="Configuration\zdfCatalog.json" />

    <!-- The logos of the channels no logo host carries (Assets/SOURCES.md). Embedded rather than installed
         next to the DLL because a plugin update replaces that folder, and because the package only ships
         dll + meta.json - see ChannelLogoAssets for why these have to end up as files on disk. -->
    <EmbeddedResource Include="Assets\*.png" />
  </ItemGroup>

</Project>
